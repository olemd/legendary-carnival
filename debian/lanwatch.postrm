#!/bin/sh
set -e

# Purge removes everything the package created at runtime: the database, reports and
# overview under the state directory. The system users are left in place, as is customary.
if [ "$1" = purge ]; then
    rm -rf /var/lib/lanwatch
fi
# The reference config is written by postinst, not shipped, so dpkg does not remove it.
if [ "$1" = remove ] || [ "$1" = purge ]; then
    rm -f /etc/lanwatch/config.toml.default
fi

#DEBHELPER#
