#!/bin/sh
set -e

# The full, documented reference config is kept next to the user's own config.toml and
# refreshed on every upgrade. It is copied here instead of shipped under /etc so that dpkg
# does not treat it as a conffile: config.toml stays the only file upgrades never touch.
# Before the copy, the old and new reference are compared, and settings that are new since
# the previous version are listed, so an upgrade still says what became available.
ref=/etc/lanwatch/config.toml.default
new=/usr/share/lanwatch/config.toml.default

# "section.key" for every key in a reference file, whether set or commented out. A
# commented-out header that is a whole line ("# [snmp.devices.fw]") is an example table
# and counts too. Tables named by the user ([snmp.devices.<name>]) are listed under
# "<name>", not under the example's name.
settings() {
    awk 'function named(s) { if (index(s, "snmp.devices.") == 1) return "snmp.devices.<name>"; return s }
         /^\[[A-Za-z0-9_.]+\]/ { s = named(substr($0, 2, index($0, "]") - 2)) }
         /^# ?\[[A-Za-z0-9_.-]+\][ \t]*$/ { h = $0; sub(/^# ?\[/, "", h); sub(/\].*/, "", h); s = named(h) }
         /^(# ?)?[a-z_]+ = / { k = $0; sub(/^# ?/, "", k); sub(/ =.*/, "", k); print s "." k }' "$1" \
        | sort -u
}

if [ "$1" = configure ]; then
    if [ -f "$ref" ]; then
        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        settings "$ref" >"$tmp/old"
        settings "$new" >"$tmp/new"
        added=$(comm -13 "$tmp/old" "$tmp/new")
        if [ -n "$added" ]; then
            echo "lanwatch: new settings since the previous version (your config.toml is untouched):"
            printf '%s\n' "$added" | head -20 | sed 's/^/    /'
            [ "$(printf '%s\n' "$added" | wc -l)" -le 20 ] || echo "    ..."
            echo "    see $ref for what they do"
        fi
    fi
    install -m 0644 "$new" "$ref"
    # A config this version cannot read keeps the service from starting (a key that was
    # renamed, say). Say why here, where the upgrade is watched, not only in the journal.
    if [ -f /etc/lanwatch/config.toml ] \
        && ! err=$(/usr/bin/lanwatch --config /etc/lanwatch/config.toml config path 2>&1 >/dev/null); then
        echo "lanwatch: /etc/lanwatch/config.toml has a problem; the service will not start until it is fixed:"
        printf '%s\n' "$err" | sed 's/^/    /'
    fi
fi

#DEBHELPER#
